# WebSocket Frontend Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Judge0 code-execution sandbox (server-only; never expose to browser)
# AWS_VM_URL wins if set (remote pre-provisioned Judge0 VM).
# Otherwise falls back to a local Judge0 docker instance (http://localhost:2358).
# JUDGE0_URL is a manual override for either case.
AWS_VM_URL=
JUDGE0_URL=
