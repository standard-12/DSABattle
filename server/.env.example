# WebSocket Server Configuration
WS_PORT=8080

# Supabase (service-role key — server only, bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Judge0 code-execution sandbox
# AWS_VM_URL wins if set (remote pre-provisioned Judge0 VM).
# Otherwise falls back to a local Judge0 docker instance (http://localhost:2358).
# JUDGE0_URL is a manual override for either case.
AWS_VM_URL=
JUDGE0_URL=http://localhost:2358
